# Always-on automation server
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Delay before sending the professional PDF to the client (ms)
PDF_DELAY_MS=90000

# Postgres (leads, clients, appointments, staff, documents)
DATABASE_URL=postgresql://jac:jac_dev_change_me@127.0.0.1:5433/jacmotors

# Dealer inbox (E.164 without +)
WHATSAPP_DEALER_E164=21699757218

# WhatsApp Cloud API (Meta)
# Leave empty → dry-run mode (messages saved in server/data/outbox)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Force dry-run even with token: WHATSAPP_DRY_RUN=1

# Optional n8n webhook base
# N8N_WEBHOOK_BASE=https://your-host/n8n/webhook

# Frontend (optional absolute API base; leave empty to use Vite proxy / same origin)
VITE_API_BASE=

# Default admin seed (created on first DB init if staff_users empty)
# admin@jacmotors.tn / JacMotors2026!
